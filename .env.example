# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram id администраторов через запятую (видят /stats, получают сообщения о сбоях)
ADMIN_IDS=
# Код доступа для агентов пилота (пусто = бот открыт всем)
ACCESS_CODE=
# Срок для агентов, подключившихся до появления личных сроков, ГГГГ-ММ-ДД
PILOT_UNTIL=
# Пробный период агентства: столько дней с момента, когда первый сотрудник ввёл код с визитки
TRIAL_DAYS=14
# 1 = новый пробный период по коду с визитки только после одобрения админом (кнопки в боте)
TRIAL_APPROVAL=1
# Сколько сотрудников в тарифе агентства (0 = без ограничения). Сверх лимита — платные места
TRIAL_SEATS=0
LITE_SEATS=2
STANDARD_SEATS=5
PRO_SEATS=10
# Цены тарифов в сумах за PAID_DAYS дней (цена за всё агентство)
PRICE_LITE=150000
PRICE_STANDARD=300000
PRICE_PRO=500000
PAID_DAYS=30
# Карта для перевода и имя владельца (показываются при оплате)
PAY_CARD=
PAY_CARD_OWNER=
# Оплата через Click: ссылка из QR-кода и USSD ({amount} заменяется суммой). Пусто = не показывать
CLICK_URL=https://indoor.click.uz/pay?id=0114811&t=0
CLICK_USSD=*880*0114811*{amount}#
# За сколько дней до конца срока напоминать об оплате
WARN_DAYS=3
# Лайт: максимум районов и как часто присылать подборку, в минутах
LITE_MAX_DISTRICTS=3
LITE_DIGEST_MIN=60
# Вебхук Make, который пишет оплаты в таблицу «Makon Radar — подписчики»
SUBS_WEBHOOK=
# Контакт для продления, показывается агенту (например @username или +998...)
CONTACT=
# 0 = не собирать с OLX (для проверки Telegram-части)
OLX_ENABLED=1
# Как часто проверять OLX, в секундах
POLL_INTERVAL=600
# Рассылать только объявления, созданные не раньше чем столько часов назад
FRESH_HOURS=48
# Курс для фильтра цены: сколько сумов в 1 USD
UZS_PER_USD=12800
DB_PATH=data/bot.db
# Ссылка на вебхук Make секретаря Дильнозы. Если указана, под объявлением есть кнопка «⭐ Дильнозе»
DILNOZA_WEBHOOK=
# Кто видит кнопку «⭐ Дильнозе»: Telegram id через запятую. Пусто = только админы (ADMIN_IDS)
DILNOZA_USERS=
# Раз во столько часов проверять, не сняты ли объекты Дильнозы с OLX (снятые удаляются из её таблицы)
DILNOZA_CHECK_HOURS=24
